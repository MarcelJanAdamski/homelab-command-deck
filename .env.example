# Copy to .env:  cp .env.example .env
# Defaults let `docker compose up -d --build` run without this file.

# ---- Gateway --------------------------------------------------------------------------------
# Port on the Docker host that serves the dashboard.
PORT=3000
# Host[:port] you type into the browser. Homepage rejects other Host headers ("host not allowed").
# Optional: the default is derived from PORT (localhost:<PORT>). Set it when you open the dashboard
# via a LAN IP or host name. Comma-separated, no spaces. Example: localhost:3000,10.0.0.20:3000
# HOMEPAGE_ALLOWED_HOSTS=localhost:3000
# Time zone of the containers.
TZ=Europe/Berlin

# ---- Demo mode ------------------------------------------------------------------------------
# 1 = the sidecars serve made-up data (no keys, no internet needed except weather/pollen).
# 0 = real operation for sprit-tracker and muell-tracker (DEMO is global for those two): then the keys/URLs of the
#     sections below (Tankerkoenig key + station, calendar URL) are required.
# claude-usage has no real mode and always serves demo data (see sidecars/claude-usage/README.md).
DEMO=1

# ---- sprit-tracker (fuel prices, Tankerkoenig / MTS-K) -------------------------------------
# API key from https://creativecommons.tankerkoenig.de
TK_APIKEY=
# Tankerkoenig station UUID
STATION_ID=
# Name shown in the panel
STATION_NAME=

# ---- muell-tracker (waste collection calendar) ----------------------------------------------
# iCal URL of your waste authority; "{year}" is replaced by the year.
ICS_URL=
# Optional: URL-encoded form body (with "{year}") -> the calendar is fetched with POST instead of GET.
ICS_FORM=
# Optional: map event names to kinds, "prefix=kind|prefix=kind" (kinds: rest, bio, papier, gelb).
# Empty = keyword detection (rest/bio/papier/gelb).
KIND_MAP=
# Optional: notice box scraped from a web page (set both or none).
NOTICE_URL=
NOTICE_HEAD=
# Label under the panel title (empty in demo mode = "Musterstraße").
LABEL=
# Optional hazardous-waste collection: first date of each plan year, comma-separated,
# repeated every SCHAD_DAYS days. Empty = no hazardous-waste dates.
SCHAD_ANCHOR=
SCHAD_DAYS=14
SCHAD_ZEIT=9–12 Uhr
# Plan PDF URL with "{year}" (only used to detect that next year's plan is online).
SCHAD_PDF=
# MM-DD from which next year's plan is looked for.
SCHAD_CHECK_FROM=12-01
