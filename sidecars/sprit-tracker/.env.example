# sprit-tracker - example settings (standalone use). Copy to .env; never commit real values.
# API key from https://creativecommons.tankerkoenig.de (not needed with DEMO=1)
TK_APIKEY=
# Tankerkoenig station UUID; required unless DEMO is on
STATION_ID=
# Display name in the panel
STATION_NAME=Tankstelle
# HTTP port the service listens on (default 8080)
# PORT=8080
# Demo only, without an API key: synthetic demo prices, no network access (own database prices-demo.db).
# Leave commented out for real operation.
# DEMO=1
